{
    "manifest_version": 3,

    "name": "DSA Tutor",

    "version": "1.6.0",

    "description": "An AI-powered Chrome extension for learning DSA through guided hints.",

    "permissions": [
        "activeTab",
        "scripting",
        "storage"
    ],

    "host_permissions": [
        "https://leetcode.com/*",
        "https://codeforces.com/*",
        "http://localhost:5000/*"
    ],

    "background": {
        "service_worker": "background.js"
    },

    "action": {
        "default_title": "Open DSA Tutor",
        "default_popup": "popup/popup.html"
    },

    "content_scripts": [
        {
            "matches": [
                "https://leetcode.com/*",
                "https://codeforces.com/*"
            ],

            "js": [
                "content/content.js"
            ],

            "css": [
                "content/content.css"
            ]
        }
    ]
}